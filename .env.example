# ─── LLM Provider (OpenRouter or Featherless) ─────────────────────────────────
# OpenRouter:   https://openrouter.ai/keys
# Featherless:  https://featherless.ai/account
LLM_API_KEY=your-api-key-here

# Base URL for the OpenAI-compatible endpoint
# OpenRouter:   https://openrouter.ai/api/v1
# Featherless:  https://api.featherless.ai/v1
LLM_BASE_URL=https://openrouter.ai/api/v1

# Model identifier (as listed by your provider)
# Game Master model (narrative orchestration, streaming)
LLM_MODEL=moonshotai/Kimi-K2-Instruct-0905

# Persona model (NPC voice agent)
PERSONA_MODEL=Steelskull/L3.3-Nevoria-R1-70b

# Arbiter model (tool calling, temperature=0.5, top_p=0.65)
ARBITER_MODEL=Groq/Llama-3-Groq-8B-Tool-Use

# ─── App Settings ─────────────────────────────────────────────────────────────
APP_NAME=AI RPG Agent
APP_DEBUG=false

CHAINLIT_AUTH_SECRET=rpg_agent_local_secret_change_me_in_production