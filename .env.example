# ─── LLM Provider (OpenRouter or Featherless) ─────────────────────────────────
# OpenRouter:   https://openrouter.ai/keys
# Featherless:  https://featherless.ai/account
LLM_API_KEY=your-api-key-here

# Base URL for the OpenAI-compatible endpoint
# OpenRouter:   https://openrouter.ai/api/v1
# Featherless:  https://api.featherless.ai/v1
LLM_BASE_URL=https://openrouter.ai/api/v1

# Model identifier (as listed by your provider)
# OpenRouter example:   openai/gpt-4o-mini
# Featherless example:  meta-llama/Llama-3.1-8B-Instruct
LLM_MODEL=openai/gpt-4o-mini

# ─── App Settings ─────────────────────────────────────────────────────────────
APP_NAME=AI RPG Agent
APP_DEBUG=false
